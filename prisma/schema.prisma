generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id           String   @id @default(cuid())
  name         String
  description  String?
  manager      String?
  sponsor      String?
  responsible  String?
  area         String?
  status       String   @default("Planificación")
  hasEquipment Boolean  @default(false)
  startDate    DateTime
  endDate      DateTime
  phases       Phase[]
  
  parentProjectId String?
  parentProject   ParentProject? @relation(fields: [parentProjectId], references: [id], onDelete: SetNull)

  // Nuevos Metadatos de Proyecto Bupa
  type              String?   // Tipo (ej: Proyecto SCL)
  methodology       String?   // Tradicional / Híbrido / Ágil
  pmo               String?   // PMO / Scrum Master
  budget            Float?    // Presupuesto Total Aprobado
  jiraId            String?   // Jira / ID
  cutoffDate        DateTime? // Fecha de Corte
  goLiveDate        DateTime? // Fecha Go-Live
  statusTime        String?   // Semáforo Tiempo (Verde, Amarillo, Rojo)
  statusQuality     String?   // Semáforo Calidad (Verde, Amarillo, Rojo)
  statusCost        String?   // Semáforo Costo (Verde, Amarillo, Rojo)
  nextMilestone     String?   // Próximo Hito
  nextMilestoneDate DateTime? // Fecha Próximo Hito
  achievements      String?   // Logros del período (Markdown/Texto)
  nextSteps         String?   // Próximos pasos (Markdown/Texto)
  blockers          String?   // Bloqueadores / Riesgos activos (Markdown/Texto)
  expectedProgress  Int?      // % Avance Esperado
  delayDays         Int?      // Desviación Tiempo (días)
  consolidatedRisk  String?   // Riesgo Consolidado
  costStatusText    String?   // Estado de Costos (Texto)

  risks             Risk[]
  costItems         CostItem[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([parentProjectId])
}

model ParentProject {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Phase {
  id        String   @id @default(cuid())
  wbsId     String?
  name      String
  progress  Int      @default(0)
  startDate DateTime
  endDate   DateTime
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Task {
  id           String       @id @default(cuid())
  wbsId        String?
  name         String
  startDate    DateTime
  endDate      DateTime
  duration     Int
  progress     Int          @default(0)
  assignee     String       @default("Sin Asignar")
  status       String       @default("Not Started")
  priority     String       @default("Media")
  notes        String?
  jiraCode     String?      // Jira Integration
  
  phaseId      String
  phase        Phase        @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  
  // WBS Infinita: Tareas Padre e Hijas
  parentId     String?
  parent       Task?        @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks     Task[]       @relation("TaskSubtasks")
  
  // Dependencias (Cascada)
  dependencies String?      // Almacenado como JSON array string para compatibilidad simple
  
  // Nuevos Campos de Planificación y Control
  realStartDate     DateTime? // Inicio Real
  realEndDate       DateTime? // Término Real
  expectedProgress  Int?      // % Esperado (Hoy)
  delayDays         Int?      // Desv. (días)
  semaphore         String?   // Semáforo Tarea (Verde, Amarillo, Rojo, etc.)
  estimatedCost     Float?    // Costo Estim.
  realCost          Float?    // Costo Real
  risk              String?   // Riesgo (Bajo, Medio, Alto, Crítico)
  customFields      String    @default("{}")

  attachments  Attachment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([phaseId])
  @@index([parentId])
}

model Attachment {
  id         String    @id @default(cuid())
  name       String
  type       String
  url        String
  taskId     String?
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([taskId])
  @@index([incidentId])
}

model Recinto {
  id         String              @id @default(cuid())
  name       String
  code       String
  isActive   Boolean             @default(true)
  equipments ClinicalEquipment[]
  analytes   Analyte[]           // Relación con analitos
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model ClinicalEquipment {
  id              String   @id @default(cuid())
  recintoId       String
  recinto         Recinto  @relation(fields: [recintoId], references: [id], onDelete: Cascade)
  name            String
  section         String
  levantamiento   String   @default("No iniciado")
  parametrizacion String   @default("No iniciado")
  pruebas         String   @default("No iniciado")
  capacitacion    String   @default("No iniciado")
  validacion      String   @default("No iniciado")
  golive          String   @default("No iniciado")
  responsable     String
  compromisoDate  String?
  observaciones   String
  pendienteDe     String
  projectId       String?  // Asociación opcional a Proyecto
  customFields    String   @default("{}")
  deletedAt       DateTime? // Soft Delete Support
  analytes        Analyte[] // Relación con analitos
  scopeStatus     String   @default("ACTIVE")
  releasePhaseId  String?
  releasePhase    ReleasePhase? @relation(fields: [releasePhaseId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([recintoId])
  @@index([projectId])
  @@index([releasePhaseId])
}

model MasterUser {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String?  // Almacena la contraseña cifrada
  role          String
  maxTasksLimit Int      @default(5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Incident {
  id            String   @id @default(cuid())
  indexId       Int
  fecha         String
  recintoName   String
  equipmentName String
  faseAfectada  String
  descripcion   String
  impacto       String   @default("Bajo")
  responsable   String
  estado        String   @default("Abierto")
  planDeAccion  String
  fechaCierre   String
  projectId     String?  // Asociación opcional a Proyecto
  idTicket      String?  // ID del Ticket / Jira
  customFields  String   @default("{}")
  attachments   Attachment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

model Training {
  id            String   @id @default(cuid())
  indexId       Int
  participant   String
  role          String
  recintoName   String
  moduleTheme   String
  equipmentName String
  fecha         String
  instructor    String
  duration      Float    @default(0)
  result        String   @default("Pendiente") // Aprobado, Pendiente, Reprobado
  observaciones String
  customFields  String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Stakeholder {
  id            String   @id @default(cuid())
  indexId       Int      // ID numérico correlativo Excel-Like
  name          String
  role          String   // Cargo / Rol
  orgSede       String   // Organización / Sede
  area          String   // Área
  contact       String   // Contacto (email/fono)
  influence     String   @default("Medio") // Alto, Medio, Bajo
  impact        String   @default("Medio") // Alto, Medio, Bajo
  notes         String   // Notas / Expectativas
  projectId     String?  // Asociación opcional a Proyecto
  customFields  String   @default("{}") // JSON string para columnas dinámicas
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

model MasterEquipment {
  id        String   @id @default(cuid())
  name      String   @unique
  section   String   @default("General")
  category  String   @default("Clínico")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Analyte {
  id               String             @id @default(cuid())
  instrumentName   String             // Nombre original del instrumento (ej: "Advia1201AD")
  transmissionCode String             // Código de transmisión
  testCode         String             // Código de Test
  name             String             // Nombre de analito
  description      String?            // Descripción extensa
  section          String             // Sección de laboratorio (Hematología, etc)
  state            String             @default("No Iniciado") // Estado de transmisión
  
  // Relaciones
  equipmentId      String?            // Enlace opcional a ClinicalEquipment
  equipment        ClinicalEquipment? @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  recintoId        String?            // Enlace opcional a Recinto
  recinto          Recinto?           @relation(fields: [recintoId], references: [id], onDelete: SetNull)
  customFields     String             @default("{}")
  scopeStatus      String             @default("INHERITED")
  releasePhaseId   String?
  releasePhase     ReleasePhase?      @relation(fields: [releasePhaseId], references: [id], onDelete: SetNull)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([recintoId])
  @@index([equipmentId])
  @@index([releasePhaseId])
}

model ReleasePhase {
  id          String              @id @default(cuid())
  name        String              @unique
  description String?
  isActive    Boolean             @default(true)
  equipments  ClinicalEquipment[]
  analytes    Analyte[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ScopeAuditLog {
  id            String   @id @default(cuid())
  itemId        String
  itemType      String
  itemName      String
  previousScope String
  newScope      String
  reasonCode    String
  justification String
  userEmail     String
  createdAt     DateTime @default(now())
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Risk {
  id                 String    @id @default(cuid())
  indexId            String    // R01, R02, etc.
  description        String
  category           String?   // Sistema LIS, Infraestructura, Comercial, etc.
  probability        Int       @default(1) // 1-5
  impact             Int       @default(1) // 1-5
  score              Int       @default(1) // Calculado: prob * imp
  level              String    // Bajo, Medio, Alto, Crítico
  mitigationPlan     String?
  responsible        String?
  limitDate          DateTime?
  status             String    @default("Activo") // Activo, Mitigado, Cerrado
  associatedActivity String?   // Actividad asociada del WBS
  mitigationCost     Float?
  observations       String?
  
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([projectId])
}

model CostItem {
  id             String   @id @default(cuid())
  indexId        String   // C01, C02, etc.
  description    String
  category       String?  // Licencia Software, Hardware TI, Reserva, etc.
  provider       String?  // Proveedor / Resp.
  approvedBudget Float    @default(0) // Presupuesto Aprobado
  ocEmitted      String?  // OC Emitida (Sí/No/Referencia)
  ocNumber       String?  // N° OC / Referencia
  realCost       Float    @default(0) // Costo Real Ejecutado
  ocStatus       String   @default("Pendiente") // Vacío / Emitida / Facturada / Pagada
  observations   String?
  
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId])
}

model ImportTemplate {
  id          String   @id @default(cuid())
  name        String
  headersHash String   @unique
  mapping     String   // Almacena JSON string de la relación ColumnaOriginal -> CampoOficial
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
